# Copier ce fichier en .env puis compléter.

# Garde-fou de développement : 1 = toute opération réelle hors de ./sandbox/ est refusée.
TRIBIN_DEV_SANDBOX=1

# Clé API Anthropic (ne jamais la committer). En usage normal, elle est stockée dans le trousseau système.
ANTHROPIC_API_KEY=

# Modèle d'IA utilisé pour les propositions.
TRIBIN_MODEL=claude-haiku-5-5

# Facultatif : dossier des données de l'appli (base, journal, profil). Par défaut : dossier système via platformdirs.
# TRIBIN_DATA_DIR=

# Facultatif : emplacement de la sandbox (par défaut ./sandbox à la racine du dépôt).
# TRIBIN_SANDBOX_DIR=

# Facultatif : nom affiché dans le journal des opérations (par défaut : nom de session système).
# TRIBIN_USER=
